<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ========== Departments ========== -->
        <record id="dept_hr" model="hr.department">
            <field name="name">Human Resources</field>
        </record>
        <record id="dept_engineering" model="hr.department">
            <field name="name">Engineering</field>
        </record>
        <record id="dept_marketing" model="hr.department">
            <field name="name">Marketing</field>
        </record>
        <record id="dept_finance" model="hr.department">
            <field name="name">Finance</field>
        </record>

        <!-- ========== Jobs ========== -->
        <record id="job_hr_manager" model="hr.job">
            <field name="name">HR Manager</field>
            <field name="department_id" ref="dept_hr"/>
        </record>
        <record id="job_dev" model="hr.job">
            <field name="name">Software Developer</field>
            <field name="department_id" ref="dept_engineering"/>
        </record>
        <record id="job_designer" model="hr.job">
            <field name="name">UI/UX Designer</field>
            <field name="department_id" ref="dept_engineering"/>
        </record>
        <record id="job_marketing_exec" model="hr.job">
            <field name="name">Marketing Executive</field>
            <field name="department_id" ref="dept_marketing"/>
        </record>
        <record id="job_accountant" model="hr.job">
            <field name="name">Accountant</field>
            <field name="department_id" ref="dept_finance"/>
        </record>

        <!-- ========== Users ========== -->

        <!-- HR Admin User -->
        <record id="user_hr_admin" model="res.users">
            <field name="name">Priya Sharma</field>
            <field name="login">hr@dayflow.com</field>
            <field name="password">hr123</field>
            <field name="email">hr@dayflow.com</field>
            <field name="groups_id" eval="[(4, ref('dayflow_hrms.group_dayflow_hr'))]"/>
        </record>

        <!-- Employee Users -->
        <record id="user_emp1" model="res.users">
            <field name="name">Rahul Verma</field>
            <field name="login">rahul@dayflow.com</field>
            <field name="password">emp123</field>
            <field name="email">rahul@dayflow.com</field>
            <field name="groups_id" eval="[(4, ref('dayflow_hrms.group_dayflow_employee'))]"/>
        </record>

        <record id="user_emp2" model="res.users">
            <field name="name">Sneha Patel</field>
            <field name="login">sneha@dayflow.com</field>
            <field name="password">emp123</field>
            <field name="email">sneha@dayflow.com</field>
            <field name="groups_id" eval="[(4, ref('dayflow_hrms.group_dayflow_employee'))]"/>
        </record>

        <record id="user_emp3" model="res.users">
            <field name="name">Arjun Nair</field>
            <field name="login">arjun@dayflow.com</field>
            <field name="password">emp123</field>
            <field name="email">arjun@dayflow.com</field>
            <field name="groups_id" eval="[(4, ref('dayflow_hrms.group_dayflow_employee'))]"/>
        </record>

        <record id="user_emp4" model="res.users">
            <field name="name">Kavya Iyer</field>
            <field name="login">kavya@dayflow.com</field>
            <field name="password">emp123</field>
            <field name="email">kavya@dayflow.com</field>
            <field name="groups_id" eval="[(4, ref('dayflow_hrms.group_dayflow_employee'))]"/>
        </record>

        <!-- ========== Employees ========== -->

        <record id="emp_hr_admin" model="hr.employee">
            <field name="name">Priya Sharma</field>
            <field name="user_id" ref="user_hr_admin"/>
            <field name="job_id" ref="job_hr_manager"/>
            <field name="department_id" ref="dept_hr"/>
            <field name="work_email">hr@dayflow.com</field>
        </record>

        <record id="emp1" model="hr.employee">
            <field name="name">Rahul Verma</field>
            <field name="user_id" ref="user_emp1"/>
            <field name="job_id" ref="job_dev"/>
            <field name="department_id" ref="dept_engineering"/>
            <field name="work_email">rahul@dayflow.com</field>
        </record>

        <record id="emp2" model="hr.employee">
            <field name="name">Sneha Patel</field>
            <field name="user_id" ref="user_emp2"/>
            <field name="job_id" ref="job_designer"/>
            <field name="department_id" ref="dept_engineering"/>
            <field name="work_email">sneha@dayflow.com</field>
        </record>

        <record id="emp3" model="hr.employee">
            <field name="name">Arjun Nair</field>
            <field name="user_id" ref="user_emp3"/>
            <field name="job_id" ref="job_marketing_exec"/>
            <field name="department_id" ref="dept_marketing"/>
            <field name="work_email">arjun@dayflow.com</field>
        </record>

        <record id="emp4" model="hr.employee">
            <field name="name">Kavya Iyer</field>
            <field name="user_id" ref="user_emp4"/>
            <field name="job_id" ref="job_accountant"/>
            <field name="department_id" ref="dept_finance"/>
            <field name="work_email">kavya@dayflow.com</field>
        </record>

        <!-- ========== Attendance Records (today) ========== -->

        <!-- Rahul — Present (full day) -->
        <record id="att_emp1_today" model="hr.attendance">
            <field name="employee_id" ref="emp1"/>
            <field name="check_in" eval="(DateTime.now() + relativedelta(hour=9, minute=15, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="check_out" eval="(DateTime.now() + relativedelta(hour=17, minute=30, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- Sneha — Present (half day worked) -->
        <record id="att_emp2_today" model="hr.attendance">
            <field name="employee_id" ref="emp2"/>
            <field name="check_in" eval="(DateTime.now() + relativedelta(hour=10, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="check_out" eval="(DateTime.now() + relativedelta(hour=14, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- Kavya — Half-day (checked in late, still here) -->
        <record id="att_emp4_today" model="hr.attendance">
            <field name="employee_id" ref="emp4"/>
            <field name="check_in" eval="(DateTime.now() + relativedelta(hour=13, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- ========== Leave Requests ========== -->

        <!-- Arjun — Approved leave (sick, today) -->
        <record id="leave_emp3_approved" model="hr.leave">
            <field name="employee_id" ref="emp3"/>
            <field name="name">Doctor appointment</field>
            <field name="request_date_from" eval="DateTime.now().strftime('%Y-%m-%d')"/>
            <field name="request_date_to" eval="DateTime.now().strftime('%Y-%m-%d')"/>
            <field name="state">validate</field>
        </record>

        <!-- Rahul — Pending leave (paid, future) -->
        <record id="leave_emp1_pending" model="hr.leave">
            <field name="employee_id" ref="emp1"/>
            <field name="name">Family function</field>
            <field name="request_date_from" eval="(DateTime.now() + relativedelta(days=3)).strftime('%Y-%m-%d')"/>
            <field name="request_date_to" eval="(DateTime.now() + relativedelta(days=4)).strftime('%Y-%m-%d')"/>
            <field name="state">confirm</field>
        </record>

        <!-- Sneha — Rejected leave (unpaid, past) -->
        <record id="leave_emp2_rejected" model="hr.leave">
            <field name="employee_id" ref="emp2"/>
            <field name="name">Personal trip</field>
            <field name="request_date_from" eval="(DateTime.now() + relativedelta(days=-5)).strftime('%Y-%m-%d')"/>
            <field name="request_date_to" eval="(DateTime.now() + relativedelta(days=-3)).strftime('%Y-%m-%d')"/>
            <field name="state">refuse</field>
        </record>

        <!-- Kavya — Approved leave (tomorrow) -->
        <record id="leave_emp4_approved" model="hr.leave">
            <field name="employee_id" ref="emp4"/>
            <field name="name">Work from home</field>
            <field name="request_date_from" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="request_date_to" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="state">validate</field>
        </record>

    </data>
</odoo>
