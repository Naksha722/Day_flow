<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ===== HR/Admin user ===== -->
        <record id="demo_user_hr" model="res.users">
            <field name="name">Demo HR Admin</field>
            <field name="login">hr@dayflow.demo</field>
            <field name="email">hr@dayflow.demo</field>
            <field name="password">hr123</field>
            <field name="groups_id" eval="[(4, ref('dayflow_hrms.group_dayflow_hr'))]"/>
        </record>
        <record id="demo_employee_hr" model="hr.employee">
            <field name="name">Demo HR Admin</field>
            <field name="user_id" ref="demo_user_hr"/>
        </record>

        <!-- ===== 4 employees ===== -->
        <record id="demo_user_emp1" model="res.users">
            <field name="name">Employee One</field>
            <field name="login">emp1@dayflow.demo</field>
            <field name="email">emp1@dayflow.demo</field>
            <field name="password">emp123</field>
            <field name="groups_id" eval="[(4, ref('dayflow_hrms.group_dayflow_employee'))]"/>
        </record>
        <record id="demo_employee_1" model="hr.employee">
            <field name="name">Employee One</field>
            <field name="user_id" ref="demo_user_emp1"/>
        </record>

        <record id="demo_user_emp2" model="res.users">
            <field name="name">Employee Two</field>
            <field name="login">emp2@dayflow.demo</field>
            <field name="email">emp2@dayflow.demo</field>
            <field name="password">emp123</field>
            <field name="groups_id" eval="[(4, ref('dayflow_hrms.group_dayflow_employee'))]"/>
        </record>
        <record id="demo_employee_2" model="hr.employee">
            <field name="name">Employee Two</field>
            <field name="user_id" ref="demo_user_emp2"/>
        </record>

        <record id="demo_user_emp3" model="res.users">
            <field name="name">Employee Three</field>
            <field name="login">emp3@dayflow.demo</field>
            <field name="email">emp3@dayflow.demo</field>
            <field name="password">emp123</field>
            <field name="groups_id" eval="[(4, ref('dayflow_hrms.group_dayflow_employee'))]"/>
        </record>
        <record id="demo_employee_3" model="hr.employee">
            <field name="name">Employee Three</field>
            <field name="user_id" ref="demo_user_emp3"/>
        </record>

        <record id="demo_user_emp4" model="res.users">
            <field name="name">Employee Four</field>
            <field name="login">emp4@dayflow.demo</field>
            <field name="email">emp4@dayflow.demo</field>
            <field name="password">emp123</field>
            <field name="groups_id" eval="[(4, ref('dayflow_hrms.group_dayflow_employee'))]"/>
        </record>
        <record id="demo_employee_4" model="hr.employee">
            <field name="name">Employee Four</field>
            <field name="user_id" ref="demo_user_emp4"/>
        </record>

        <!-- ===== Attendance: present / half-day / absent / present ===== -->
        <!-- Employee 1: present today, full day -->
        <record id="demo_attendance_1" model="hr.attendance">
            <field name="employee_id" ref="demo_employee_1"/>
            <field name="check_in" eval="datetime.datetime.now().replace(hour=9, minute=0, second=0)"/>
            <field name="check_out" eval="datetime.datetime.now().replace(hour=18, minute=0, second=0)"/>
        </record>
        <!-- Employee 2: half-day (short hours) -->
        <record id="demo_attendance_2" model="hr.attendance">
            <field name="employee_id" ref="demo_employee_2"/>
            <field name="check_in" eval="datetime.datetime.now().replace(hour=13, minute=0, second=0)"/>
            <field name="check_out" eval="datetime.datetime.now().replace(hour=16, minute=0, second=0)"/>
        </record>
        <!-- Employee 3: absent (no attendance record) -->
        <!-- Employee 4: present today -->
        <record id="demo_attendance_4" model="hr.attendance">
            <field name="employee_id" ref="demo_employee_4"/>
            <field name="check_in" eval="datetime.datetime.now().replace(hour=9, minute=15, second=0)"/>
            <field name="check_out" eval="datetime.datetime.now().replace(hour=17, minute=45, second=0)"/>
        </record>

        <!-- ===== Leave requests: pending / approved / rejected ===== -->
        <!-- Employee 1: pending leave -->
        <record id="demo_leave_pending" model="hr.leave">
            <field name="employee_id" ref="demo_employee_1"/>
            <field name="name">Family function</field>
            <field name="request_date_from" eval="(DateTime.today() + timedelta(days=3)).strftime('%Y-%m-%d')"/>
            <field name="request_date_to" eval="(DateTime.today() + timedelta(days=4)).strftime('%Y-%m-%d')"/>
            <field name="state">confirm</field>
        </record>
        <!-- Employee 2: approved leave (past) -->
        <record id="demo_leave_approved" model="hr.leave">
            <field name="employee_id" ref="demo_employee_2"/>
            <field name="name">Fever</field>
            <field name="request_date_from" eval="(DateTime.today() - timedelta(days=2)).strftime('%Y-%m-%d')"/>
            <field name="request_date_to" eval="(DateTime.today() - timedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="state">validate</field>
        </record>
        <!-- Employee 3: rejected leave -->
        <record id="demo_leave_rejected" model="hr.leave">
            <field name="employee_id" ref="demo_employee_3"/>
            <field name="name">Extended personal trip</field>
            <field name="request_date_from" eval="(DateTime.today() + timedelta(days=10)).strftime('%Y-%m-%d')"/>
            <field name="request_date_to" eval="(DateTime.today() + timedelta(days=15)).strftime('%Y-%m-%d')"/>
            <field name="state">refuse</field>
        </record>

        <!-- ===== Payroll: add once Samarth's dayflow.payroll model is merged ===== -->
        <!--
        <record id="demo_payroll_1" model="dayflow.payroll">
            <field name="employee_id" ref="demo_employee_1"/>
            <field name="basic_salary">45000</field>
            <field name="allowances">5000</field>
            <field name="deductions">2000</field>
            <field name="month">August 2026</field>
        </record>
        -->

    </data>
</odoo>
