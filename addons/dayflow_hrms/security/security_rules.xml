<odoo>
    <record id="rule_dayflow_employee_own_employee" model="ir.rule">
        <field name="name">Dayflow employee: own employee record</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="rule_dayflow_hr_all_employee" model="ir.rule">
        <field name="name">Dayflow HR: all employee records</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('group_dayflow_hr'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_dayflow_employee_own_attendance" model="ir.rule">
        <field name="name">Dayflow employee: own attendance</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_dayflow_hr_all_attendance" model="ir.rule">
        <field name="name">Dayflow HR: all attendance</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="groups" eval="[(4, ref('group_dayflow_hr'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_dayflow_employee_own_leave" model="ir.rule">
        <field name="name">Dayflow employee: own leave</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_dayflow_hr_all_leave" model="ir.rule">
        <field name="name">Dayflow HR: all leave</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="groups" eval="[(4, ref('group_dayflow_hr'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- hr.version (Employee Contract) — bypass multi-company rules -->
    <record id="rule_dayflow_employee_own_version" model="ir.rule">
        <field name="name">Dayflow employee: own version records</field>
        <field name="model_id" ref="hr.model_hr_version"/>
        <field name="groups" eval="[(4, ref('group_dayflow_employee'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_dayflow_hr_all_version" model="ir.rule">
        <field name="name">Dayflow HR: all version records</field>
        <field name="model_id" ref="hr.model_hr_version"/>
        <field name="groups" eval="[(4, ref('group_dayflow_hr'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
