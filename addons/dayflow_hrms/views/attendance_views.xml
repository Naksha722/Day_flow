<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action: employee's own attendance, scoped by user -->
    <record id="action_dayflow_my_attendance" model="ir.actions.act_window">
        <field name="name">My Attendance</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
    </record>

    <!-- Action: HR view of all attendance -->
    <record id="action_dayflow_all_attendance" model="ir.actions.act_window">
        <field name="name">All Attendance</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- My Attendance — visible to all employees -->
    <menuitem id="menu_dayflow_attendance_my"
              name="My Attendance"
              parent="dayflow_hrms.menu_dayflow_root"
              action="action_dayflow_my_attendance"
              sequence="10"/>

    <!-- All Attendance — HR only -->
    <menuitem id="menu_dayflow_attendance_all"
              name="All Attendance"
              parent="dayflow_hrms.menu_dayflow_root"
              action="action_dayflow_all_attendance"
              groups="dayflow_hrms.group_dayflow_hr"
              sequence="11"/>
</odoo>
