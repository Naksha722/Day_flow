<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard URL Action -->
    <record id="action_dashboard" model="ir.actions.act_url">
        <field name="name">Dashboard</field>
        <field name="url">/dayflow/dashboard</field>
        <field name="target">self</field>
    </record>

    <!-- Dashboard Menu — first item under Dayflow root -->
    <menuitem id="menu_dayflow_dashboard"
              name="Dashboard"
              parent="dayflow_hrms.menu_dayflow_root"
              action="action_dashboard"
              sequence="1"/>
</odoo>
