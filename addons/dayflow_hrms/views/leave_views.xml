<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action: employee's own leave requests -->
    <record id="action_dayflow_my_leave" model="ir.actions.act_window">
        <field name="name">Apply / My Leave</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
    </record>

    <!-- Action: HR view of pending/approved leaves -->
    <record id="action_dayflow_leave_approvals" model="ir.actions.act_window">
        <field name="name">Leave Approvals</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'confirm')]</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <!-- Apply / My Leave — visible to all employees -->
    <menuitem id="menu_dayflow_leave_my"
              name="Apply / My Leave"
              parent="dayflow_hrms.menu_dayflow_root"
              action="action_dayflow_my_leave"
              sequence="20"/>

    <!-- Leave Approvals — HR only -->
    <menuitem id="menu_dayflow_leave_approvals"
              name="Leave Approvals"
              parent="dayflow_hrms.menu_dayflow_root"
              action="action_dayflow_leave_approvals"
              groups="dayflow_hrms.group_dayflow_hr"
              sequence="21"/>
</odoo>
