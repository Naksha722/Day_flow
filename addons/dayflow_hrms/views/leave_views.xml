<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========== Leave Views ========== -->

    <!-- Leave Tree View -->
    <record id="view_leave_tree" model="ir.ui.view">
        <field name="name">hr.leave.tree.dayflow</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <tree string="Leave Requests"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'confirm'"
                  decoration-success="state == 'validate'"
                  decoration-danger="state == 'refuse'">
                <field name="employee_id"/>
                <field name="name" string="Description"/>
                <field name="holiday_status_id" string="Leave Type"/>
                <field name="request_date_from"/>
                <field name="request_date_to"/>
                <field name="number_of_days" widget="float_time"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirm'"
                       decoration-success="state == 'validate'"
                       decoration-danger="state == 'refuse'"/>
            </tree>
        </field>
    </record>

    <!-- Leave Form View -->
    <record id="view_leave_form" model="ir.ui.view">
        <field name="name">hr.leave.form.dayflow</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <form string="Leave Request">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            invisible="state != 'confirm'" class="oe_highlight"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="state != 'confirm'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirm,validate"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="holiday_status_id"/>
                        </group>
                        <group>
                            <field name="request_date_from"/>
                            <field name="request_date_to"/>
                            <field name="number_of_days"/>
                        </group>
                    </group>
                    <group>
                        <field name="name" placeholder="Reason for leave..."/>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Additional details..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Leave Search View -->
    <record id="view_leave_search" model="ir.ui.view">
        <field name="name">hr.leave.search.dayflow</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <search string="Leave Requests">
                <field name="employee_id"/>
                <field name="holiday_status_id"/>
                <filter name="my_leaves" string="My Leaves"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="pending" string="Pending"
                        domain="[('state', '=', 'confirm')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state', '=', 'validate')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'state'}"/>
                    <filter string="Leave Type" name="group_type"
                            context="{'group_by': 'holiday_status_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Leave Action -->
    <record id="action_leave" model="ir.actions.act_window">
        <field name="name">Leave Requests</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="dayflow_hrms.view_leave_search"/>
        <field name="context">{'search_default_my_leaves': 1}</field>
    </record>

    <!-- Leave Menu under Dayflow root -->
    <menuitem id="menu_dayflow_leave"
              name="Leave"
              parent="dayflow_hrms.menu_dayflow_root"
              sequence="20"/>

    <menuitem id="menu_dayflow_leave_apply"
              name="Apply Leave"
              parent="dayflow_hrms.menu_dayflow_leave"
              action="action_leave"
              sequence="10"/>

    <menuitem id="menu_dayflow_leave_requests"
              name="Leave Requests"
              parent="dayflow_hrms.menu_dayflow_leave"
              action="action_leave"
              sequence="20"/>
</odoo>
